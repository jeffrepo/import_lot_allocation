<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_rework" model="ir.module.category">
        <field name="name">Rework</field>
        <field name="description">Access rights for Rework and Import Lot operations.</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_rework_user" model="res.groups">
        <field name="name">Rework User</field>
        <field name="category_id" ref="module_category_rework"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_rework_manager" model="res.groups">
        <field name="name">Rework Manager</field>
        <field name="category_id" ref="module_category_rework"/>
        <field name="implied_ids" eval="[(4, ref('group_rework_user'))]"/>
    </record>

    <record id="stock_package_plan_company_rule" model="ir.rule">
        <field name="name">Planned delivery packages by company</field>
        <field name="model_id" ref="model_stock_package_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_rework_user'))]"/>
    </record>

    <record id="stock_rework_order_company_rule" model="ir.rule">
        <field name="name">Rework orders by company</field>
        <field name="model_id" ref="model_stock_rework_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_rework_user'))]"/>
    </record>

    <record id="stock_expected_package_company_rule" model="ir.rule">
        <field name="name">Future packages by company</field>
        <field name="model_id" ref="model_stock_expected_package"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_rework_user'))]"/>
    </record>

    <record id="stock_rework_line_company_rule" model="ir.rule">
        <field name="name">Rework lines by company</field>
        <field name="model_id" ref="model_stock_rework_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_rework_user'))]"/>
    </record>
</odoo>
