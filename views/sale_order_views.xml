<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_package_plan_tree" model="ir.ui.view">
        <field name="name">stock.package.plan.tree</field>
        <field name="model">stock.package.plan</field>
        <field name="arch" type="xml">
            <tree string="Planned Packages" decoration-success="state == 'done'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="import_lot_id"/>
                <field name="partner_id"/>
                <field name="package_type_id"/>
                <field name="real_package_count"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_stock_package_plan_form" model="ir.ui.view">
        <field name="name">stock.package.plan.form</field>
        <field name="model">stock.package.plan</field>
        <field name="arch" type="xml">
            <form string="Planned Package">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_real_packages" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="real_package_count" widget="statinfo" string="Physical Packages"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Planned Package Reference"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sale_order_id"/>
                            <field name="import_lot_id" readonly="1"/>
                            <field name="source_package_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_id" invisible="1"/>
                            <field name="package_type_id" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sale Lines">
                            <field name="sale_line_ids" readonly="1">
                                <tree>
                                    <field name="product_id"/>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom"/>
                                    <field name="qty_delivered"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Physical Packages">
                            <field name="real_package_ids" readonly="1">
                                <tree create="0" delete="0">
                                    <field name="name"/>
                                    <field name="planned_picking_id"/>
                                    <field name="package_type_id"/>
                                    <field name="location_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Stock Moves">
                            <field name="move_ids" readonly="1">
                                <tree create="0" delete="0">
                                    <field name="picking_id"/>
                                    <field name="product_id"/>
                                    <field name="product_uom_qty"/>
                                    <field name="quantity_done"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_order_form_import_lot" model="ir.ui.view">
        <field name="name">sale.order.form.import.lot</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_import_lot_allocations" type="object" class="oe_stat_button" icon="fa-tags">
                    <field name="import_lot_allocation_count" widget="statinfo" string="Import Lot Allocations"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_uom_qty']" position="after">
                <field name="import_lot_id"
                       string="Import Lot"
                       domain="[('company_id', '=', parent.company_id), ('state', 'not in', ('closed', 'cancelled')), ('line_ids.product_id', '=', product_id), ('line_ids.available_to_promise_qty', '>', 0), '|', ('restricted_sale_order_id', '=', False), ('restricted_sale_order_id', '=', parent.id)]"
                       groups="import_lot_allocation.group_rework_user"
                       optional="show"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='qty_delivered']" position="after">
                <field name="import_lot_allocated_qty" readonly="1" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
