<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_picking_form_import_lot" model="ir.ui.view">
        <field name="name">stock.picking.form.import.lot</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="import_lot_id"/>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']/tree/field[@name='product_id']" position="after">
                <field name="planned_sale_order_id" invisible="1"/>
                <field name="planned_package_id"
                       domain="[('sale_order_id', '=', planned_sale_order_id)]"
                       context="{'default_sale_order_id': planned_sale_order_id}"
                       attrs="{'readonly': [('state', 'in', ('done', 'cancel'))], 'column_invisible': [('parent.picking_type_code', '!=', 'outgoing')]}"
                       optional="show"
                       groups="import_lot_allocation.group_rework_user"/>
            </xpath>
        </field>
    </record>
</odoo>
